# Aucun .env n'est requis pour lancer la demo locale en mode deterministic.
# Ce fichier sert de repere documentaire si vous ajoutez plus tard un proxy,
# une execution developpeur centralisee ou des defaults de provider.

OPENAI_API_KEY=
GEMINI_API_KEY=
VITE_DEFAULT_PROVIDER=openai
VITE_DEFAULT_MODEL=gpt-4o-mini
